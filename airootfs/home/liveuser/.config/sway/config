# OG-OS seed sway config — deliberately generic defaults, not this
# project's personal tuning (see OS-PLAN.md's resolved config-split
# decision: seed defaults + let og-settings' own onboarding import a
# personal config afterward, don't hardcode the ISO to one machine's
# bindings).

set $mod Mod4
set $term alacritty

font pango:sans-serif 10

output * bg #1a1b26 solid_color

exec_always og-bar
exec og-notify
exec og-clip
exec og-notif-center

# Live-session only (not carried into etc/skel for the installed system):
# auto-launch the graphical installer, matching how most public live-ISO
# distros greet a fresh user. liveuser has NOPASSWD wheel sudo, so `sudo`
# runs headless with no polkit agent needed. install-ogos.sh remains
# available as a manual/power-user fallback (run from a terminal).
exec sudo calamares

bindsym $mod+Return exec $term
bindsym $mod+i exec sudo calamares
bindsym $mod+d exec og-search-launch
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle

include /etc/sway/config.d/*
