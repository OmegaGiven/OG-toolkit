# Maintainer: OmegaGiven
# Built on the dev machine, not inside the archiso chroot — see
# og-os/OS-PLAN.md phase 2. No install.sh existed in-repo; package()
# written from scratch against Cargo.toml's [[bin]] name. Sources via
# rsync from the LIVE working tree, not git — these repos carry
# uncommitted work a git+file:// clone would silently drop.
pkgname=og-notify
pkgver=0.1.0
pkgrel=1
pkgdesc="OG-toolkit themed notification pop-up effects layer"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-notify"
license=('unknown')
depends=('gcc-libs' 'wayland')
makedepends=('cargo' 'rsync')
source=()

prepare() {
  rsync -a --exclude target --exclude .git --exclude pkg "$HOME/.local/src/og-notify/" "$srcdir/og-notify/"
  rsync -a --exclude target --exclude .git --exclude pkg "$HOME/.local/src/OG-toolkit/" "$srcdir/OG-toolkit/"
}

build() {
  cd "$srcdir/og-notify"
  cargo build --release
}

package() {
  install -Dm755 "$srcdir/og-notify/target/release/og-notify" "$pkgdir/usr/bin/og-notify"
}
