# Maintainer: OmegaGiven
# Source repo is file-manager; binary/pkg name is og-files. Built on the
# dev machine, not inside the archiso chroot — see og-os/OS-PLAN.md
# phase 2. ffmpeg/zip/unzip/tar/alacritty are optional runtime deps
# (video thumbs, archive ops, terminal spawn) — left out of depends,
# already covered by base's everyday-utilities group or user config.
# Sources via rsync from the LIVE working tree, not git — these repos
# carry uncommitted work a git+file:// clone would silently drop.
pkgname=og-files
pkgver=20260908
pkgrel=1
pkgdesc="OG-toolkit file manager"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-toolkit"
license=('MIT')
depends=('gcc-libs' 'wayland' 'ttf-nerd-fonts-symbols' 'xdg-utils')
makedepends=('cargo' 'rsync')
source=()

prepare() {
  rsync -a --exclude target --exclude .git --exclude pkg --exclude distro "$HOME/.local/src/OG-toolkit/" "$srcdir/OG-toolkit/"
}

build() {
  cd "$srcdir/OG-toolkit/apps/og-files"
  cargo build --release
}

package() {
  install -Dm755 "$srcdir/OG-toolkit/target/release/og-files" "$pkgdir/usr/bin/og-files"
}
