# Maintainer: OmegaGiven
# Built on the dev machine, not inside the archiso chroot — see
# og-os/OS-PLAN.md phase 2. No install.sh existed in-repo; package()
# written from scratch against Cargo.toml's [[bin]] name.
pkgname=og-notify
pkgver=0.1.0
pkgrel=1
pkgdesc="OG-toolkit themed notification pop-up effects layer"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-notify"
license=('unknown')
depends=('gcc-libs' 'wayland')
makedepends=('cargo' 'git')
source=("og-notify::git+file://$HOME/.local/src/og-notify#branch=main"
        "OG-toolkit::git+file://$HOME/.local/src/OG-toolkit#branch=main")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "$srcdir/og-notify"
  cargo build --release --locked
}

package() {
  install -Dm755 "$srcdir/og-notify/target/release/og-notify" "$pkgdir/usr/bin/og-notify"
}
