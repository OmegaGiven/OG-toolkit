# Maintainer: OmegaGiven
# Built on the dev machine, not inside the archiso chroot — see
# og-os/OS-PLAN.md phase 2.
pkgname=og-clip
pkgver=0.1.0
pkgrel=1
pkgdesc="OG-toolkit clipboard history"
arch=('x86_64')
url="https://github.com/OmegaGiven/og-clip"
license=('unknown')
depends=('gcc-libs' 'wayland' 'wl-clipboard')
makedepends=('cargo' 'git')
source=("og-clip::git+file://$HOME/.local/src/og-clip#branch=master"
        "OG-toolkit::git+file://$HOME/.local/src/OG-toolkit#branch=main")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "$srcdir/og-clip"
  cargo build --release --locked
}

package() {
  install -Dm755 "$srcdir/og-clip/target/release/og-clip" "$pkgdir/usr/bin/og-clip"
}
