# Maintainer: OmegaGiven
# Source repo is file-manager; binary/pkg name is og-files. Built on the
# dev machine, not inside the archiso chroot — see og-os/OS-PLAN.md
# phase 2. ffmpeg/zip/unzip/tar/alacritty are optional runtime deps
# (video thumbs, archive ops, terminal spawn) — left out of depends,
# already covered by base's everyday-utilities group or user config.
pkgname=og-files
pkgver=0.1.0
pkgrel=1
pkgdesc="OG-toolkit file manager"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-file-manager"
license=('unknown')
depends=('gcc-libs' 'wayland' 'ttf-nerd-fonts-symbols' 'xdg-utils')
makedepends=('cargo' 'git')
source=("file-manager::git+file://$HOME/.local/src/file-manager#branch=main"
        "OG-toolkit::git+file://$HOME/.local/src/OG-toolkit#branch=main")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "$srcdir/file-manager"
  cargo build --release --locked
}

package() {
  install -Dm755 "$srcdir/file-manager/target/release/og-files" "$pkgdir/usr/bin/og-files"
}
