# Maintainer: OmegaGiven
# Source repo is app-store; binary/pkg name is og-apps. Built on the dev
# machine, not inside the archiso chroot — see og-os/OS-PLAN.md phase 2.
# No install.sh existed in-repo; package() written from scratch against
# Cargo.toml's [[bin]] name (repo README says app-manager — stale, wrong).
pkgname=og-apps
pkgver=0.1.0
pkgrel=1
pkgdesc="OG-toolkit pacman/AUR/Flatpak app store GUI"
arch=('x86_64')
url="https://github.com/OmegaGiven/linux-packages"
license=('unknown')
depends=('gcc-libs' 'wayland' 'pacman' 'yay' 'flatpak')
makedepends=('cargo' 'git')
source=("app-store::git+file://$HOME/.local/src/app-store#branch=main"
        "OG-toolkit::git+file://$HOME/.local/src/OG-toolkit#branch=main")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "$srcdir/app-store"
  cargo build --release --locked
}

package() {
  install -Dm755 "$srcdir/app-store/target/release/og-apps" "$pkgdir/usr/bin/og-apps"
}
