# Maintainer: OmegaGiven
# Source repo is sway-control; binary/pkg name is og-settings.
# Built on the dev machine, not inside the archiso chroot — see
# og-os/OS-PLAN.md phase 2.
pkgname=og-settings
pkgver=0.1.0
pkgrel=1
pkgdesc="OG-toolkit control panel (theme, audio, network, printing, power, sysmonitor)"
arch=('x86_64')
url="https://github.com/OmegaGiven/sway-settings-manager"
license=('unknown')
depends=('gcc-libs' 'wayland' 'btop' 'bluez' 'iwd')
makedepends=('cargo' 'git')
source=("sway-control::git+file://$HOME/.local/src/sway-control#branch=main"
        "OG-toolkit::git+file://$HOME/.local/src/OG-toolkit#branch=main")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "$srcdir/sway-control"
  cargo build --release --locked
}

package() {
  install -Dm755 "$srcdir/sway-control/target/release/og-settings" "$pkgdir/usr/bin/og-settings"
}
