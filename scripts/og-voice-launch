#!/bin/sh
# Press-edge wrapper for the push-to-talk bind:
#   bindsym $mod+v exec ~/.local/bin/og-voice-launch
#   bindsym --release $mod+v exec ~/.local/bin/og-voice --stop
#
# Guards against double-launch if the key repeats/bounces (or the user
# holds it, releases, and presses again before the first instance has
# fully exited) — og-voice's own main.rs also checks the lock file
# before doing any work, so this is a cheap early-out, not the only
# guard, matching the belt-and-suspenders pattern og-search-launch etc.
# use elsewhere in the suite.
#
# Full path throughout — sway's exec environment doesn't have
# ~/.local/bin on PATH.

if pgrep -f '/og-voice$' >/dev/null 2>&1; then
    exit 0
fi

exec ~/.local/bin/og-voice
